# Optional path to an official static GTFS ZIP file exported/downloaded from an authorized source.
GTFS_ZIP=data/namma_metro_gtfs.zip

# Optional IUDX resource endpoint for latest/live data.
IUDX_LATEST_URL=

# IUDX access token; keep this on the backend only and never in the APK.
IUDX_TOKEN=

# Optional GTFS-RT vehicle-position or trip-update feed URL exposed through your authorized IUDX setup.
IUDX_GTFS_RT_URL=

# Host and port for the API service.
HOST=0.0.0.0
PORT=8000
